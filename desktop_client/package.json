{
  "name": "desktop_client",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k -p \"[{name}]\" -n \"FastAPI,Vite,Electron\" -c \"green,cyan,magenta\" \"python ../server.py\" \"vite\" \"wait-on tcp:127.0.0.1:8000 tcp:127.0.0.1:5173 && electron .\"",
    "start": "concurrently -k -p \"[{name}]\" -n \"FastAPI,Vite,Electron\" -c \"green,cyan,magenta\" \"python ../server.py\" \"vite\" \"wait-on tcp:127.0.0.1:8000 tcp:127.0.0.1:5173 && electron .\"",
    "app": "concurrently -k -p \"[{name}]\" -n \"FastAPI,Vite,Electron\" -c \"green,cyan,magenta\" \"python ../server.py\" \"vite\" \"wait-on tcp:127.0.0.1:8000 tcp:127.0.0.1:5173 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.9",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.mak.agency",
    "productName": "MAK Enterprise AI Agency",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
