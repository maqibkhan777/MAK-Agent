# =====================================================================
# MAK Enterprise OS - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your API keys.
# =====================================================================

# Primary LLM Provider (Groq API)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API (Optional Fallback)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Serper Google Search API (Optional for SERP Marketing Tool)
SERPER_API_KEY=your_serper_api_key_here

# OpenRouter API (Optional Fallback)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# HuggingFace API Key for Chroma Embeddings (Defaults to dummy if unset)
CHROMA_HUGGINGFACE_API_KEY=dummy
